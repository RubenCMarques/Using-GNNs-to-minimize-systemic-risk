    "| `node2vec_v2_128_srisk_dataset.parquet` | `node2vec_v2_128a_srisk_dataset.parquet` | `node2vec_v2_128b_srisk_dataset.parquet` |\n",
    "| `graphsage_v3_128_srisk_nolog_dataset.parquet` | `graphsage_v3_128a_srisk_nolog_dataset.parquet` | `graphsage_v3_128b_srisk_nolog_dataset.parquet` |\n",
    "| `node2vec_v3_128_srisk_nolog_dataset.parquet` | `node2vec_v3_128a_srisk_nolog_dataset.parquet` | `node2vec_v3_128b_srisk_nolog_dataset.parquet` |"
